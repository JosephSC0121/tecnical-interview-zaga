{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "upstream",
      "runtimeExecutable": "env",
      "runtimeArgs": ["UPSTREAM_SLOW_RATE=0", "UPSTREAM_TIMEOUT_RATE=0", "uv", "run", "--directory", "upstream", "upstream"],
      "port": 8081
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "--env-file", ".env", "uvicorn", "app.main:create_app", "--factory", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
